{
  "name": "devsweep",
  "version": "0.1.0",
  "private": true,
  "description": "find and clear the junk coding agents leave behind",
  "type": "module",
  "bin": {
    "devsweep": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
