{
  "name": "dustpan",
  "version": "0.1.0",
  "description": "find and clear the junk coding agents leave behind",
  "type": "module",
  "bin": {
    "dustpan": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node src/cli.ts",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j4ckwinter/dustpan.git"
  },
  "homepage": "https://github.com/j4ckwinter/dustpan#readme",
  "bugs": {
    "url": "https://github.com/j4ckwinter/dustpan/issues"
  },
  "author": "Jack Winter",
  "keywords": [
    "cli",
    "cleanup",
    "disk-space",
    "node_modules",
    "git-worktree",
    "playwright",
    "coding-agents"
  ]
}
