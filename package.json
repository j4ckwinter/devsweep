    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node src/cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
